# SMTP configuration for the contact form (netlify/functions/contact.mts)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=your-smtp-password

# Address the contact form delivers messages to
CONTACT_TO_EMAIL=you@example.com
# Address messages are sent from (must be a domain verified with your SMTP provider,
# or the provider's shared sandbox address, e.g. onboarding@resend.dev)
CONTACT_FROM_EMAIL=no-reply@example.com
