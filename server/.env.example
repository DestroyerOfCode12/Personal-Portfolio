# Server
PORT=4000

# SMTP configuration for the contact form (nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Address the contact form delivers messages to
CONTACT_TO_EMAIL=you@example.com
# Address messages are sent from (must usually be authorized by your SMTP provider)
CONTACT_FROM_EMAIL=no-reply@example.com

# Comma-separated list of allowed origins for CORS (frontend URL)
CORS_ORIGIN=http://localhost:5173
